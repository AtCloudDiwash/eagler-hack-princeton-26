# Backend configuration. Copy to backend/.env — ALL API keys live here (never in the frontend).

# Vexcel API 2.0 (imagery tiles + /property/extract). Without a key the app runs in labelled DEMO mode
# using a recorded downtown-Houston sample (backend/fixtures/vexcel_houston_demo.json). That file is
# licensed data and gitignored: create it once with `python scripts/record_demo_fixture.py`.
VEXCEL_API_KEY=your_vexcel_api_key
VEXCEL_API_BASE_URL=https://api.vexcelgroup.com/v2

# Ollama (all LLM inference). Model must support tool calling (qwen3:8b recommended; qwen3:14b is slower).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_THINK=false

# Optional: US Census ACS demographics (free key: https://api.census.gov/data/key_signup.html)
CENSUS_API_KEY=

# Optional: Matterport (interior agent). Also needs a tour linked to the property; none in this build.
MATTERPORT_API_KEY=
MATTERPORT_API_SECRET=

DATABASE_PATH=./turnkey.db
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Agent limits (bounded, purposeful investigations)
AGENT_MAX_MODEL_CALLS=8
AGENT_TIMEOUT_S=240
