# Backend configuration. Copy to backend/.env — ALL API keys live here (never in the frontend).

# Vexcel API 2.0 (imagery tiles + /property/extract). Without a key the app runs in labelled DEMO mode
# using a recorded downtown-Houston sample (backend/fixtures/vexcel_houston_demo.json). That file is
# licensed data and gitignored: create it once with `python scripts/record_demo_fixture.py`.
VEXCEL_API_KEY=your_vexcel_api_key
VEXCEL_API_BASE_URL=https://api.vexcelgroup.com/v2

# LLM fallback chain, tried in order. A provider that is out of usage (or not installed / not logged in)
# is skipped for LLM_COOLDOWN_S seconds; any other error falls through to the next one for that call.
#   codex  = Codex CLI with YOUR Codex / ChatGPT login (`codex login`; credentials stay in ~/.codex)
#   claude = Claude Code CLI with YOUR Claude login (`claude auth login`)
#   ollama = local Ollama model (`ollama pull qwen3:8b`)
LLM_PROVIDERS=codex,claude,ollama
LLM_COOLDOWN_S=1200

# Codex. Leave these empty for the defaults.
CODEX_BIN=                      # auto-detected: `codex` on PATH, or the CLI bundled in the ChatGPT/Codex app
CODEX_MODEL=                    # default: the model in ~/.codex/config.toml
CODEX_REASONING_EFFORT=low      # low | medium | high (higher = slower, more thorough)
CODEX_MAX_CONCURRENCY=4         # parallel codex calls (agents run concurrently)
CODEX_TIMEOUT_S=180

# Claude Code (fallback #1). In Docker, the macOS Keychain login isn't visible: set CLAUDE_CODE_OAUTH_TOKEN
# (from `claude setup-token`) or ANTHROPIC_API_KEY here to enable it inside the container.
CLAUDE_BIN=                     # auto-detected: `claude` on PATH or ~/.local/bin/claude
CLAUDE_MODEL=sonnet             # sonnet | opus | haiku (or a full model id)
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_TIMEOUT_S=180

# Ollama (fallback #2, fully local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Optional: US Census ACS demographics (free key: https://api.census.gov/data/key_signup.html)
CENSUS_API_KEY=

# Optional: Matterport Model API (interior agent). Link a tour to a building on its panel (paste the
# showcase URL); the 3D tour always embeds. Interior data (rooms, dimensions, tags, detected objects) needs
# an API token whose organization can access the model: KEY = token id, SECRET = token secret.
# Offline: record a scan once with `python scripts/record_matterport_fixture.py <tour url>`.
MATTERPORT_API_KEY=
MATTERPORT_API_SECRET=
# Optional sandbox token (only sees the account's demo model): for development and the GraphQL contract test.
MATTERPORT_SANDBOX_API_KEY=
MATTERPORT_SANDBOX_API_SECRET=

DATABASE_PATH=./turnkey.db
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Agent limits (bounded, purposeful investigations)
AGENT_MAX_MODEL_CALLS=8
AGENT_TIMEOUT_S=240
# Deadline for a whole analysis (agents, follow-ups, narrative)
ANALYSIS_TIMEOUT_S=900
