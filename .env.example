# Turnkey Matchmaker environment variables. Placeholders only; never commit real keys.
#
# Backend: copy this file to backend/.env  (cd backend && cp ../.env.example .env)
#   backend/app/config.py loads backend/.env on startup. Values starting with "your_" are treated
#   as "not set", so this file works unchanged: everything runs in mock mode.
# Frontend: only API_ORIGIN (bottom of this file) applies; put it in frontend/.env.local.
# Full table with defaults: docs/SECURITY_AND_ENV.md

# --- Mode ---------------------------------------------------------------------------------
# true (default) = always use the fixtures in backend/fixtures/. Set to false to try live provider
# calls for each provider whose key is set below. Any live failure falls back to the fixtures.
USE_MOCK_DATA=true
# Timeout in seconds for each live provider HTTP call (default 8).
PROVIDER_TIMEOUT_SECONDS=8

# --- CoStar (commercial listings) ----------------------------------------------------------
COSTAR_API_KEY=your_costar_api_key_here
# Placeholder endpoint; replace with the base URL from your CoStar developer docs.
COSTAR_API_BASE_URL=https://api.costar.example/v1

# --- Matterport (3D tours / floor plans) ---------------------------------------------------
MATTERPORT_API_KEY=your_matterport_api_key_here
MATTERPORT_API_BASE_URL=https://api.matterport.com/api/models/graph

# --- Vexcel (aerial imagery) ---------------------------------------------------------------
VEXCEL_API_KEY=your_vexcel_api_key_here
# Sent as the X-API-KEY header (backend only). Imagery is cached in backend/static/vexcel-cache/
# (gitignored, licensed). Hackathon accounts may be geofenced (e.g. Los Angeles / Houston only).
VEXCEL_API_BASE_URL=https://api.vexcelgroup.com/v2

# --- Geocoding (optional) ------------------------------------------------------------------
# Read by config.py but not used yet (fixture listings already carry lat/lng). Reserved.
GEOCODING_API_KEY=your_geocoding_api_key_here

# --- Anthropic / Claude (optional requirements parser) -------------------------------------
# When set, Claude is tried first to parse the free-text requirements; any error or timeout
# falls back to the built-in regex parser. Leave as-is to use regex only.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Backend server ------------------------------------------------------------------------
# Criteria registry path (default: backend/criteria.yaml).
# CRITERIA_PATH=/absolute/path/to/criteria.yaml
# Comma-separated origins allowed by CORS (default http://localhost:3000).
CORS_ORIGINS=http://localhost:3000
# SQLite run history. Relative sqlite paths resolve against backend/ (default sqlite:///./turnkey.db).
DATABASE_URL=sqlite:///./turnkey.db

# --- Frontend (frontend/.env.local) --------------------------------------------------------
# Backend origin the Next.js dev server proxies /api/v1, /static and /health to. Read server-side
# by frontend/next.config.ts, so it needs no NEXT_PUBLIC_ prefix and never reaches the browser.
# API_ORIGIN=http://localhost:8000
